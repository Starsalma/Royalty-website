---
// Desktop: floating WhatsApp button. Mobile: a sticky two-button bar (WhatsApp + Call or Catalogue),
// the highest-converting spot on a phone screen.
import { whatsappLink, messages, telLink, hasPhone } from '../lib/contact';
import Icon from './Icon.astro';

interface Props { message?: string }
const message = Astro.props.message ?? messages.general();
---
<a class="wa-float" href={whatsappLink(message)} target="_blank" rel="noopener" data-track="whatsapp_click" data-location="floating">
  <Icon name="whatsapp" size={26} />
  <span class="visually-hidden">Chat with us on WhatsApp</span>
</a>

<div class="mobile-bar" role="region" aria-label="Quick enquiry">
  <a class="btn btn--whatsapp" href={whatsappLink(message)} target="_blank" rel="noopener" data-track="whatsapp_click" data-location="sticky_bar">
    <Icon name="whatsapp" /> WhatsApp
  </a>
  {hasPhone
    ? <a class="btn btn--outline" href={telLink()} data-track="phone_click" data-location="sticky_bar"><Icon name="phone" /> Call</a>
    : <a class="btn btn--outline" href="/catalogue/" data-track="catalogue_cta_click" data-location="sticky_bar"><Icon name="book" /> Catalogue</a>}
</div>

<style>
  .wa-float { position: fixed; right: 24px; bottom: 24px; z-index: 40; display: none; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: var(--whatsapp); color: #fff; box-shadow: 0 10px 30px rgb(31 122 77 / 0.35); transition: transform 0.3s var(--ease); }
  .wa-float:hover { transform: scale(1.06); }
  .mobile-bar { position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--s-2); padding: var(--s-2) var(--s-3) calc(var(--s-2) + env(safe-area-inset-bottom)); background: rgb(251 248 243 / 0.97); border-top: 1px solid var(--line); backdrop-filter: blur(8px); }
  .mobile-bar .btn { min-height: 50px; }
  @media (min-width: 900px) { .wa-float { display: grid; } .mobile-bar { display: none; } }
</style>
