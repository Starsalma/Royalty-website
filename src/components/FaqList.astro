---
// Native <details> accordion: accessible, keyboard friendly and zero JS.
// Pair with schema.faqPage() using the same array so markup and schema never diverge.
interface Props { items: { q: string; a: string }[]; heading?: string; headingLevel?: 'h2' | 'h3' }
const { items, heading = 'Frequently asked questions', headingLevel: H = 'h2' } = Astro.props;
---
{items.length > 0 && (
  <div class="faq">
    <H class="faq-h">{heading}</H>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div class="a"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
)}

<style>
  .faq { max-width: 860px; }
  .faq-h { margin-bottom: var(--s-6); }
  details { border-top: 1px solid var(--line); }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-5) 0; cursor: pointer; list-style: none; font-family: var(--font-serif); font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem); line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--font-sans); font-size: 1.4rem; font-weight: 300; color: var(--gold-text); transition: transform 0.3s var(--ease); flex: none; }
  details[open] summary::after { transform: rotate(45deg); }
  .a { padding: 0 0 var(--s-5); color: var(--muted); max-width: 70ch; }
  .a p { margin: 0; }
</style>
