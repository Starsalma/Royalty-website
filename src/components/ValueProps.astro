---
// Only claims that are either true by design of the site or confirmed in site.serviceFacts.
import { site } from '../config/site';
import Icon from './Icon.astro';

type Item = { icon: 'chat' | 'gem' | 'gift' | 'truck' | 'check'; title: string; text: string; show: boolean };
const f = site.serviceFacts;
const items = ([
  { icon: 'chat', title: 'Real photos & videos on request', text: 'Ask for a close-up or a video of any piece on WhatsApp before you decide.', show: true },
  { icon: 'gem', title: 'Designs for every occasion', text: 'Bridal, festive, party and everyday pieces, organised so you find the right look fast.', show: true },
  { icon: 'gift', title: 'Bulk & gifting orders', text: 'Bridesmaid sets, return gifts and corporate gifting in matching designs.', show: f.bulkOrders },
  { icon: 'truck', title: 'Delivery across India', text: f.dispatchTime ? `Orders are dispatched in ${f.dispatchTime}.` : 'We deliver to serviceable pin codes across India.', show: f.shipsPanIndia === true },
  { icon: 'check', title: 'Cash on delivery', text: 'Pay when your order arrives, on eligible pin codes.', show: f.cashOnDelivery === true },
] satisfies Item[]).filter((i) => i.show);
---
<ul class="props">
  {items.map((i) => (
    <li data-reveal>
      <Icon name={i.icon} size={26} />
      <h3>{i.title}</h3>
      <p>{i.text}</p>
    </li>
  ))}
</ul>

<style>
  .props { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6) var(--s-5); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .props { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .props { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); } }
  li { padding-top: var(--s-5); border-top: 1px solid var(--line); }
  li :global(svg) { color: var(--gold); margin-bottom: var(--s-4); }
  h3 { font-size: 1.35rem; margin-bottom: var(--s-2); }
  p { color: var(--muted); font-size: 0.9375rem; margin: 0; }
</style>
