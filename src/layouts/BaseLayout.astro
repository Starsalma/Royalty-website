---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource-variable/manrope/index.css';
import '../styles/global.css';
import { site } from '../config/site';
import { graph, organization, website, breadcrumbs as breadcrumbSchema } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  title: string; // full <title>, should already include the brand where wanted
  description: string;
  image?: string; // absolute or root-relative URL for social cards
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  schema?: (Record<string, unknown> | null | undefined)[];
  whatsappMessage?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = site.ogImage,
  imageAlt = `${site.name} imitation jewellery`,
  type = 'website',
  noindex = false,
  crumbs,
  schema = [],
  whatsappMessage,
} = Astro.props;

const origin = Astro.site!;
// Canonical never carries query strings, so filtered/sorted views consolidate to one URL.
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, origin).href;
// Social networks do not render SVG, so SVG placeholders fall back to the default PNG card.
const ogImage = new URL(image.endsWith('.svg') ? site.ogImage : image, origin).href;
const isHome = Astro.url.pathname.replace(/\/?$/, '/') === import.meta.env.BASE_URL.replace(/\/?$/, '/');

const ld = graph(
  isHome ? organization(origin) : null,
  isHome ? website(origin) : null,
  crumbs && crumbs.length > 1 ? breadcrumbSchema(crumbs, origin) : null,
  ...schema,
);
const { gtmId, ga4Id, searchConsoleVerification } = site.analytics;
---
<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#fbf8f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    {!gtmId && ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
    <FloatingActions message={whatsappMessage} />
    <script>
      import '../scripts/analytics';
      import '../scripts/reveal';
    </script>
  </body>
</html>
